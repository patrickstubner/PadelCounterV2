{
  "name": "padel-counter-v2",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.33.4",
  "scripts": {
    "dev": "pnpm --filter @padel/web dev",
    "lint": "eslint .",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "build": "pnpm --filter @padel/web build && pnpm --filter @padel/web verify-build && pnpm --filter @padel/worker build",
    "dev:worker": "pnpm --filter @padel/worker dev"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild", "workerd"],
    "overrides": {
      "glob": "14.0.3",
      "minimatch": "11.0.3"
    }
  }
}
