# Copy to .dev.vars for `wrangler dev`. Do not put real secrets in this file.
# QUOTA_HMAC_KEY is required before a live match can be created.
# Use a random string of at least 32 characters locally. Do not commit the value.
# Staging and production take the value from the GitHub environment secret.
# Deploy writes it with `wrangler secret put QUOTA_HMAC_KEY` on stdin.
ENVIRONMENT=development
