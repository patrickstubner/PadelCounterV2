{
  "name": "@padel/worker",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --env dev",
    "test": "vitest run && vitest run --config vitest.worker.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit && tsc -p tsconfig.worker.json --noEmit",
    "build": "wrangler deploy --dry-run --outdir dist --env production"
  },
  "dependencies": {
    "@padel/core": "workspace:*"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.4.9",
    "@cloudflare/workers-types": "5.20261027.1",
    "@types/node": "26.6.5",
    "typescript": "6.0.3",
    "vitest": "5.0.4",
    "wrangler": "4.153.0"
  }
}
